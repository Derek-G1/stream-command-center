{
  "name": "litecast-broadcaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch server/main.ts --dev",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "vite build --logLevel warn && tsx server/main.ts --open",
    "serve": "tsx server/main.ts --open",
    "engine:check": "cargo check --manifest-path engine/Cargo.toml",
    "engine:build": "cargo build --release --manifest-path engine/Cargo.toml"
  },
  "dependencies": {
    "lucide-preact": "^0.468.0",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
